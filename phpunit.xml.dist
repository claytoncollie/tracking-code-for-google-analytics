<?xml version="1.0"?>
<phpunit
	bootstrap="tests/php/bootstrap.php"
	backupGlobals="false"
	colors="true"
	>
  	<testsuites>
    	<testsuite name="All">
      		<directory prefix="Test" suffix=".php">./tests/php/</directory>
    	</testsuite>
  	</testsuites>
  	<source>
		<include>
			<directory suffix=".php">./inc</directory>
		</include>
	</source>
</phpunit>
